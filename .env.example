# Core settings. Empty token means no token; no secret is needed for Lab 1.
RG_GITHUB_TOKEN=
RG_DATA_DIR=data
RG_LOG_LEVEL=INFO
RG_LOG_FORMAT=text
RG_REQUEST_TIMEOUT=30
RG_MAX_CONCURRENCY=8

# Optional legacy ETL (uv sync --locked --extra etl).
# Kaggle credentials belong in ~/.kaggle/kaggle.json, never in Git.
KAGGLE_DATASET=sazzadsiddiquelikhon/myanimelist-anime-database-july-2025
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
DATABASE_URL=sqlite:///data/processed/anime.db
